# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
# Repo-root ad-hoc scripts only — do NOT use bare `scripts/` (that also hides
# untracked files under legged_gym/scripts/eval/, breaking Altay harness patches).
/scripts/*
!/scripts/benchmark_tripler_orchestrator.py
!/scripts/benchmark_tripler_aggregate.py
!/scripts/run_eval_sweeps.sh
!/scripts/probe_speed.sh
!/scripts/run_v2_campaign_on_a100.sh
!/scripts/run_action_quad.sh
!/scripts/action_quad.sbatch
!/scripts/action_one.sbatch
!/scripts/run_him_sysid_v2_on_a115.sh
!/scripts/run_rma_dreamwaq_v2_on_kotr.sh
!/scripts/run_v4_seed1_pair.sh
# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.tiff
*.avi
*.flv
*.mov
*.wmv

# VS Code
.vscode
# logs
logs
runs

# other
*.egg-info
__pycache__
wandb
build
*debug*
resources/terrains/*.stl

# Local research wiki, agent notes, IDE/cache (not project source)
wiki/
notes/
.claude/
.fractal/
.pytest_cache/
.worktrees/
playpy

# Ad-hoc plots / screenshots at repo root or scripts cwd dumps
/plot.png
legged_gym/scripts/plot.png

# Working plans & personal session notes (keep on disk, not in git)
/plan.md
/codex_plan.md
/oracle_adam_etme.md
/bench_tasks.md
/eval_plan.md
/v4_campaign.md
/benchmark_tripler.md

# LPACR: track dashboard code only — not papers, chat logs, demo dumps
lpacr/*.md
lpacr/*.pdf
lpacr/subplans/
lpacr/tokens.md
lpacr/dashboard/data/
